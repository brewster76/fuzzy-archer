{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fuzzy-archer/manifest-v1.schema.json",
  "title": "fuzzy-archer manifest index and segments, schema version 1",
  "oneOf": [{"$ref": "#/$defs/index"}, {"$ref": "#/$defs/segment"}],
  "$defs": {
    "rev": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "index": {
      "type": "object",
      "required": ["schema_version", "generated", "week_start", "archive", "backfill", "segments"],
      "properties": {
        "schema_version": {"const": 1},
        "generated": {"type": "integer"},
        "week_start": {"type": "integer", "minimum": 0, "maximum": 6},
        "archive": {
          "type": "object",
          "required": ["first", "last"],
          "properties": {"first": {"type": ["integer", "null"]}, "last": {"type": ["integer", "null"]}}
        },
        "backfill": {
          "type": "object",
          "required": ["state", "done", "total", "updated"],
          "properties": {
            "state": {"enum": ["idle", "running", "done", "error"]},
            "done": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "updated": {"type": "integer"}
          }
        },
        "segments": {
          "type": "object",
          "propertyNames": {"enum": ["day", "week", "month", "year"]},
          "additionalProperties": {
            "type": "object",
            "propertyNames": {"pattern": "^(\\d{4}|all)$"},
            "additionalProperties": {"$ref": "#/$defs/rev"}
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": ["schema_version", "period", "segment", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "period": {"enum": ["day", "week", "month", "year"]},
        "segment": {"type": "string", "pattern": "^(\\d{4}|all)$"},
        "entries": {
          "type": "object",
          "propertyNames": {"pattern": "^(\\d{4}|\\d{6}|\\d{8})$"},
          "additionalProperties": {"$ref": "#/$defs/entry"}
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["s"],
      "properties": {
        "s": {"enum": ["ok", "gaps", "pending", "nodata", "error", "incompatible"]},
        "rev": {"$ref": "#/$defs/rev"},
        "file": {"type": "string", "pattern": "^(day|week|month|year)/(\\d{4}|\\d{6}|\\d{8})\\.json\\.gz$"},
        "missing": {"type": "array", "items": {"type": "string"}},
        "tries": {"type": "integer", "minimum": 0}
      },
      "if": {"properties": {"s": {"enum": ["ok", "gaps"]}}},
      "then": {"required": ["rev", "file"]},
      "else": {"not": {"anyOf": [{"required": ["rev"]}, {"required": ["file"]}]}}
    }
  }
}
